{
  "name": "ssh-reports-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "netlify": "netlify dev",
    "netlify:legacy": "netlify dev --envFiles .env.legacy",
    "setup-pdfjs": "mkdir -p public/lib/pdfjs && curl -L https://github.com/mozilla/pdf.js/releases/download/v5.7.284/pdfjs-5.7.284-dist.zip -o pdfjs.zip && unzip -o pdfjs.zip -d public/lib/pdfjs && rm pdfjs.zip",
    "build": "npm run setup-pdfjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node test/run-all.js && npm run test:components",
    "test:unit": "node test/unit/utils.test.js && node test/unit/proxy-ds.test.js && jest test/unit/AsyncErrorState.test.jsx --runInBand",
    "test:components": "jest --runInBand test/unit/ReportList.test.js test/unit/ReportItem.test.js test/unit/AsyncErrorState.test.jsx test/unit/PDFViewerModal.test.jsx test/unit/TelegramAuth.test.jsx test/unit/AppRoutes.test.jsx test/unit/ReportListActions.test.jsx",
    "test:integration": "node test/integration/api.test.js",
    "test:e2e": "node test/admin-status.test.js",
    "test:coverage": "node test/verify-api-coverage.js",
    "test:all": "node test/run-all.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@eslint/js": "^9.21.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^29.0.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "netlify-cli": "^23.14.0",
    "vite": "^6.4.2",
    "vite-plugin-compression": "^0.5.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.js"
    ],
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/styleMock.cjs"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "test/unit/utils.test.js",
      "test/unit/proxy-ds.test.js",
      "test/integration/api.test.js",
      "test/integration/share-ds-smoke.test.js",
      "test/admin-status.test.js"
    ]
  }
}
